# Configurações do Banco de Dados de ORIGEM
POSTGRES_HOST=db                              # Nome do container Docker do banco de origem
POSTGRES_PORT=5432                            # Porta padrão do PostgreSQL
POSTGRES_USER=northwind_user                  # Usuário do banco de origem
POSTGRES_PASSWORD=thewindisblowing            # Senha do banco de origem
POSTGRES_DB=northwind                         # Nome do banco de origem (Northwind)

# Configurações do Databricks (DESTINO)
DATABRICKS_HOST=REPLACE_ME                    # URL do workspace Databricks (ex: https://dbc-xxxx.cloud.databricks.com)
DATABRICKS_TOKEN=REPLACE_ME                   # Token de acesso pessoal (nunca versionar o real!)

# Estrutura de dados no Unity Catalog
DATABRICKS_CATALOG=northwind                  # Nome do catálogo
DATABRICKS_SCHEMA=bronze                      # Nome do schema (zona bronze)
DATABRICKS_VOLUME=source                      # Nome do volume para armazenamento de arquivos brutos

# Notebook e Job
DATABRICKS_EMAIL=meu.email@databricks.com     # Email associado ao workspace (usado no path do notebook)
DATABRICKS_NOTEBOOK_PATH=/Users/meu.email@databricks.com/ingest_bronze_delta
DATABRICKS_OWNER=meu_usuario                  # Nome do responsável (aparece nas tags do job)
DATABRICKS_CLUSTER_ID=REPLACE_ME              # ID do cluster (SQL Warehouse) usado no job (ex: abc123...)